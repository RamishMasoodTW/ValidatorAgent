# Angular Gatekeeper — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file (it is in .gitignore).
#
# In CI/CD, set these as encrypted environment secrets:
#   GitHub Actions:  Settings → Secrets and variables → Actions
#   GitLab CI:       Settings → CI/CD → Variables

# ──────────────────────────────────────────────────────────────
# AI Provider Selection
# Options: gemini | openai | anthropic | deepseek | groq | openrouter | ollama | none
# ──────────────────────────────────────────────────────────────
AI_PROVIDER=gemini

# ──────────────────────────────────────────────────────────────
# Google Gemini (Cloud)
# Get key: https://aistudio.google.com/app/apikey
# ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ──────────────────────────────────────────────────────────────
# OpenAI (Cloud)
# Get key: https://platform.openai.com/api-keys
# ──────────────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ──────────────────────────────────────────────────────────────
# Anthropic Claude (Cloud)
# Get key: https://console.anthropic.com/settings/keys
# ──────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# ──────────────────────────────────────────────────────────────
# DeepSeek (Cloud)
# Get key: https://platform.deepseek.com/api_keys
# ──────────────────────────────────────────────────────────────
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-chat

# ──────────────────────────────────────────────────────────────
# Groq (Ultra-Fast Cloud)
# Get key: https://console.groq.com/keys
# ──────────────────────────────────────────────────────────────
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# ──────────────────────────────────────────────────────────────
# OpenRouter (Universal — 300+ models)
# Get key: https://openrouter.ai/keys
# ──────────────────────────────────────────────────────────────
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=anthropic/claude-3.7-sonnet

# ──────────────────────────────────────────────────────────────
# Ollama (Local Offline AI)
# Install: https://ollama.com/download
# ──────────────────────────────────────────────────────────────
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma4:e4b

# ──────────────────────────────────────────────────────────────
# UI Options
# ──────────────────────────────────────────────────────────────
SHOW_PROGRESS=true
