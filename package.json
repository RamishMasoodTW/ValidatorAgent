{
  "name": "frontend-gatekeeper",
  "version": "1.0.0",
  "description": "Frontend Git Quality & AI Gatekeeper",
  "type": "module",
  "main": "src/engine.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:bundle": "node build.js --bundle-only",
    "build:exe": "node build.js",
    "build": "node build.js",
    "lint": "eslint src/**/*.js --max-warnings=0",
    "lint:fix": "eslint src/**/*.js --fix",
    "test": "npx jest",
    "test:ci": "npx jest --ci --coverage --forceExit",
    "test:watch": "npx jest --watch"
  },
  "keywords": [
    "git",
    "pre-push",
    "gatekeeper",
    "gemini",
    "quality",
    "devsecops"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.17.1",
    "chalk": "^5.6.2",
    "dotenv": "^17.4.2",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@jest/globals": "^29.7.0",
    "@yao-pkg/pkg": "^6.22.0",
    "babel-jest": "^29.7.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "jest": "^29.7.0"
  }
}
